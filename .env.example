# Token del bot Telegram (obbligatorio). Lo trovi da @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AA-ilTuoTokenQui

# --- Produzione su Render (webhook) ---
# URL pubblico HTTPS del Web Service, SENZA slash finale.
# Esempio: https://stellebot.onrender.com
# Se questa variabile è impostata il bot parte in modalità webhook.
# Se è vuota o assente, il bot parte in polling (sviluppo locale).
WEBHOOK_URL=

# Porta HTTP. Su Render viene iniettata automaticamente: non serve impostarla.
# In locale la puoi usare solo se avvii il webhook a mano.
PORT=10000

# Percorso del webhook (opzionale, default: webhook).
# Telegram invierà gli update a: {WEBHOOK_URL}/{WEBHOOK_PATH}
WEBHOOK_PATH=webhook

# Token segreto per validare le richieste Telegram (opzionale ma consigliato).
# Usa una stringa casuale (1-256 caratteri, A-Z a-z 0-9 _ -).
WEBHOOK_SECRET=

# Chiave NASA APOD. DEMO_KEY funziona ma ha un limite basso (~30 req/ora).
# Gratis su https://api.nasa.gov — consigliata in produzione.
NASA_API_KEY=DEMO_KEY

# Opzionale: token Hugging Face per il riconoscimento foto delle pietre (CLIP).
# Senza token il laboratorio usa solo il confronto con le miniature Wikipedia.
# Gratis su https://huggingface.co/settings/tokens
HF_TOKEN=
